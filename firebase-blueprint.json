      "description": "Refix Pro operating expense ledger entry.",
      "type": "object",
      "properties": {
        "category": { "type": "string", "enum": ["Spare Parts", "Rent & Utilities", "Tools & Equipment", "Salaries", "Marketing", "Courier & Logistics", "Other"] },
        "description": { "type": "string", "minLength": 2, "maxLength": 300 },
        "amount": { "type": "number" },
        "expenseDate": { "type": "string", "minLength": 4, "maxLength": 40 },
        "paymentMethod": { "type": "string", "enum": ["UPI", "Bank Transfer", "Cash", "Card"] },
        "referenceNumber": { "type": "string", "maxLength": 120 },
        "documentNote": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["category", "description", "amount", "expenseDate", "paymentMethod", "createdAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "In-app customer and staff notification entry.",
      "type": "object",
      "properties": {
        "recipientUid": { "type": "string", "maxLength": 128 },
        "recipientEmail": { "type": "string", "maxLength": 160 },
        "audience": { "type": "string", "enum": ["customer", "staff", "all_admins"] },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "message": { "type": "string", "minLength": 2, "maxLength": 600 },
        "category": { "type": "string", "enum": ["booking", "repair", "estimate", "payment", "appointment", "system"] },
        "relatedCode": { "type": "string", "maxLength": 60 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["audience", "title", "message", "category", "isRead", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Append-only security and ERP audit trail entry.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorEmail": { "type": "string", "minLength": 3, "maxLength": 200 },
        "actorRole": { "type": "string", "minLength": 2, "maxLength": 40 },
        "action": { "type": "string", "minLength": 2, "maxLength": 120 },
        "targetCollection": { "type": "string", "minLength": 2, "maxLength": 80 },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": "string", "minLength": 2, "maxLength": 400 },
        "metadata": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "actorEmail", "actorRole", "action", "targetCollection", "targetId", "summary", "createdAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "General customer contact message submitted from the Contact page.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 25 },
        "email": { "type": "string", "maxLength": 160 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 160 },
        "message": { "type": "string", "minLength": 5, "maxLength": 2000 },
        "isRead": { "type": "boolean" },
        "adminReply": { "type": "string", "maxLength": 2000 },
        "repliedAt": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "subject", "message", "isRead", "createdAt"]
    },
    "BlogCategory": {
      "title": "BlogCategory",
      "description": "Blog category metadata for SEO content organization.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "slug": { "type": "string", "minLength": 2, "maxLength": 100, "pattern": "^[a-z0-9-]+$" },
        "description": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "createdAt"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "SEO-optimized MacBook repair article with FAQs and structured metadata.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 5, "maxLength": 200 },
        "slug": { "type": "string", "minLength": 3, "maxLength": 200, "pattern": "^[a-z0-9-]+$" },
        "category": { "type": "string", "minLength": 2, "maxLength": 80 },
        "excerpt": { "type": "string", "minLength": 10, "maxLength": 500 },
        "content": { "type": "string", "minLength": 20, "maxLength": 30000 },
        "featuredImage": { "type": "string", "maxLength": 300000 },
        "authorName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "status": { "type": "string", "enum": ["draft", "published", "scheduled"] },
        "publishedAt": { "type": "string", "maxLength": 60 },
        "seoTitle": { "type": "string", "maxLength": 160 },
        "seoDescription": { "type": "string", "maxLength": 320 },
        "tags": { "type": "array" },
        "faqs": { "type": "array" },
        "isFeatured": { "type": "boolean" },
        "views": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "category", "excerpt", "content", "featuredImage", "authorName", "status", "publishedAt", "tags", "faqs", "isFeatured", "views", "createdAt", "updatedAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Public customer-submitted review or verified Google Business Profile review.",
      "type": "object",
      "properties": {
        "authorLabel": { "type": "string", "minLength": 2, "maxLength": 100 },
        "rating": { "type": "number" },
        "quote": { "type": "string", "minLength": 5, "maxLength": 800 },
        "source": { "type": "string", "minLength": 2, "maxLength": 80 },
        "dateLabel": { "type": "string", "maxLength": 60 },
        "isVisible": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorLabel", "rating", "quote", "source", "isVisible", "createdAt"]
    },
    "GalleryImage": {
      "title": "GalleryImage",
      "description": "Repair workstation and studio photograph displayed in About and Contact galleries.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "caption": { "type": "string", "maxLength": 300 },
        "imageUrl": { "type": "string", "minLength": 2, "maxLength": 300000 },
        "category": { "type": "string", "maxLength": 60 },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "imageUrl", "category", "sortOrder", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
