rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Boot-time Firestore connectivity check
    match /test/connection {
      allow get: if true;
    }

    // =========================================================================
    // Global Helpers
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'refixpro.in@gmail.com' ||
        request.auth.token.email == 'wifiadda76@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // =========================================================================
    // Validation Blueprints
    // =========================================================================
    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['super_admin', 'admin']
        && data.createdAt is timestamp;
    }

    function isValidWebsiteSettings(data) {
      return data.keys().hasAll([
          'businessName', 'phone', 'whatsapp', 'address', 'businessHours',
          'googleRating', 'googleReviewCount', 'heroHeadline', 'heroSubheadline', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'businessName', 'tagline', 'phone', 'whatsapp', 'email', 'websiteUrl',
          'address', 'businessHours', 'googleRating', 'googleReviewCount', 'googlePlaceId', 'googleReviewsUrl',
          'logoUrl', 'heroHeadline', 'heroSubheadline', 'heroImageUrl', 'heroSlides',
          'headerCtaText', 'headerCtaUrl', 'navLinks',
          'footerDescription', 'footerTagline', 'footerLegalText', 'footerQuickLinks', 'footerServiceLinks',
          'socialInstagram', 'socialFacebook',
          'seoTitle', 'seoDescription', 'seoKeywords', 'serviceAreasText',
          'homeFaqs', 'pageContent', 'updatedAt'
        ])
        && data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 120
        && (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 200))
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30
        && data.whatsapp is string && data.whatsapp.size() >= 5 && data.whatsapp.size() <= 30
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('websiteUrl' in data) || (data.websiteUrl is string && data.websiteUrl.size() <= 200))
        && data.address is string && data.address.size() >= 5 && data.address.size() <= 300
        && data.businessHours is string && data.businessHours.size() >= 2 && data.businessHours.size() <= 200
        && data.googleRating is number && data.googleRating >= 0 && data.googleRating <= 5
        && data.googleReviewCount is number && data.googleReviewCount >= 0
        && (!('googlePlaceId' in data) || (data.googlePlaceId is string && data.googlePlaceId.size() <= 160))
        && (!('googleReviewsUrl' in data) || (data.googleReviewsUrl is string && data.googleReviewsUrl.size() <= 400))
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 300000))
        && data.heroHeadline is string && data.heroHeadline.size() >= 5 && data.heroHeadline.size() <= 180
        && data.heroSubheadline is string && data.heroSubheadline.size() >= 10 && data.heroSubheadline.size() <= 500
        && (!('heroImageUrl' in data) || (data.heroImageUrl is string && data.heroImageUrl.size() <= 300000))
        && (!('heroSlides' in data) || (data.heroSlides is list && data.heroSlides.size() <= 10 && (data.heroSlides.size() == 0 || (data.heroSlides[0] is map && data.heroSlides[0].imageUrl is string))))
        && (!('headerCtaText' in data) || (data.headerCtaText is string && data.headerCtaText.size() <= 60))
        && (!('headerCtaUrl' in data) || (data.headerCtaUrl is string && data.headerCtaUrl.size() <= 160))
        && (!('navLinks' in data) || (data.navLinks is list && data.navLinks.size() <= 10 && (data.navLinks.size() == 0 || (data.navLinks[0] is map && data.navLinks[0].label is string && data.navLinks[0].to is string))))
        && (!('footerDescription' in data) || (data.footerDescription is string && data.footerDescription.size() <= 500))
        && (!('footerTagline' in data) || (data.footerTagline is string && data.footerTagline.size() <= 200))
        && (!('footerLegalText' in data) || (data.footerLegalText is string && data.footerLegalText.size() <= 400))
        && (!('footerQuickLinks' in data) || (data.footerQuickLinks is list && data.footerQuickLinks.size() <= 12 && (data.footerQuickLinks.size() == 0 || (data.footerQuickLinks[0] is map && data.footerQuickLinks[0].label is string && data.footerQuickLinks[0].to is string))))
        && (!('footerServiceLinks' in data) || (data.footerServiceLinks is list && data.footerServiceLinks.size() <= 12 && (data.footerServiceLinks.size() == 0 || (data.footerServiceLinks[0] is map && data.footerServiceLinks[0].label is string && data.footerServiceLinks[0].to is string))))
        && (!('socialInstagram' in data) || (data.socialInstagram is string && data.socialInstagram.size() <= 300))
        && (!('socialFacebook' in data) || (data.socialFacebook is string && data.socialFacebook.size() <= 300))
        && (!('seoTitle' in data) || (data.seoTitle is string && data.seoTitle.size() <= 120))
        && (!('seoDescription' in data) || (data.seoDescription is string && data.seoDescription.size() <= 300))
        && (!('seoKeywords' in data) || (data.seoKeywords is string && data.seoKeywords.size() <= 600))
        && (!('serviceAreasText' in data) || (data.serviceAreasText is string && data.serviceAreasText.size() <= 400))
        && (!('homeFaqs' in data) || (data.homeFaqs is list && data.homeFaqs.size() <= 15 && (data.homeFaqs.size() == 0 || (data.homeFaqs[0] is map && data.homeFaqs[0].q is string && data.homeFaqs[0].a is string))))
        && (!('pageContent' in data) || (data.pageContent is map && data.pageContent.keys().hasOnly(['home', 'services', 'models', 'book', 'track', 'about', 'blog', 'contact'])))
        && data.updatedAt is timestamp;
    }

    function isValidService(data) {
      return data.keys().hasAll([
          'title', 'slug', 'category', 'shortDescription', 'repairInfo',
          'symptoms', 'imageUrl', 'showPrice', 'isActive', 'sortOrder', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'slug', 'category', 'shortDescription', 'repairInfo',
          'symptoms', 'imageUrl', 'priceDisplay', 'showPrice', 'isActive', 'sortOrder', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 160 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.category in ['Hardware Repair', 'Display Repair', 'Battery & Charging', 'Liquid Damage Repair', 'Software & Performance', 'Other Repairs']
        && data.shortDescription is string && data.shortDescription.size() >= 5 && data.shortDescription.size() <= 400
        && data.repairInfo is string && data.repairInfo.size() >= 5 && data.repairInfo.size() <= 1200
        && data.symptoms is list && data.symptoms.size() <= 10
        && (data.symptoms.size() == 0 || (data.symptoms[0] is string && data.symptoms[0].size() <= 120))
        && data.imageUrl is string && data.imageUrl.size() <= 300000
        && (!('priceDisplay' in data) || (data.priceDisplay is string && data.priceDisplay.size() <= 80))
        && data.showPrice is bool
        && data.isActive is bool
        && data.sortOrder is number
        && data.updatedAt is timestamp;
    }

    function isValidMacBookModel(data) {
      return data.keys().hasAll([
          'category', 'name', 'yearRange', 'processor', 'commonIssues', 'isActive', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'category', 'name', 'yearRange', 'processor', 'modelIdentifiers',
          'commonIssues', 'availabilityNote', 'isActive', 'updatedAt'
        ])
        && data.category in ['MacBook Air', 'MacBook Pro', 'Intel MacBook', 'Apple Silicon M1', 'Apple Silicon M2', 'Apple Silicon M3', 'Apple Silicon M4', 'Newer Compatible Models', 'iPad & Tablet', 'iPhone']
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 140
        && data.yearRange is string && data.yearRange.size() >= 2 && data.yearRange.size() <= 60
        && data.processor is string && data.processor.size() >= 2 && data.processor.size() <= 100
        && (!('modelIdentifiers' in data) || (data.modelIdentifiers is string && data.modelIdentifiers.size() <= 160))
        && data.commonIssues is list && data.commonIssues.size() <= 10
        && (data.commonIssues.size() == 0 || (data.commonIssues[0] is string && data.commonIssues[0].size() <= 120))
        && (!('availabilityNote' in data) || (data.availabilityNote is string && data.availabilityNote.size() <= 300))
        && data.isActive is bool
        && data.updatedAt is timestamp;
    }

    function isValidRepairEnquiry(data) {
      return data.keys().hasAll([
          'enquiryCode', 'customerName', 'mobile', 'whatsapp', 'macbookModel',
          'processorType', 'serviceName', 'problemDescription', 'preferredContactMethod',
          'status', 'technicianNotes', 'repairEstimate', 'followUpDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'enquiryCode', 'customerName', 'mobile', 'whatsapp', 'email',
          'macbookModel', 'macbookYear', 'processorType', 'serviceName',
          'problemDescription', 'preferredContactMethod', 'preferredVisitDate',
          'additionalNotes', 'imageUrls', 'status', 'technicianNotes',
          'repairEstimate', 'followUpDate', 'createdAt', 'updatedAt'
        ])
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && data.enquiryCode is string && data.enquiryCode.size() >= 4 && data.enquiryCode.size() <= 32 && data.enquiryCode.matches('^RP-[A-Z0-9\\-]+$')
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
        && data.mobile is string && data.mobile.size() >= 7 && data.mobile.size() <= 25
        && data.whatsapp is string && data.whatsapp.size() >= 7 && data.whatsapp.size() <= 25
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && data.macbookModel is string && data.macbookModel.size() >= 2 && data.macbookModel.size() <= 140
        && (!('macbookYear' in data) || (data.macbookYear is string && data.macbookYear.size() <= 40))
        && data.processorType is string && data.processorType.size() <= 80
        && data.serviceName is string && data.serviceName.size() >= 2 && data.serviceName.size() <= 160
        && data.problemDescription is string && data.problemDescription.size() <= 2000
        && data.preferredContactMethod in ['WhatsApp', 'Phone Call', 'Email']
        && (!('preferredVisitDate' in data) || (data.preferredVisitDate is string && data.preferredVisitDate.size() <= 40))
        && (!('additionalNotes' in data) || (data.additionalNotes is string && data.additionalNotes.size() <= 1000))
        && (!('imageUrls' in data) || (data.imageUrls is list && data.imageUrls.size() <= 4 && (data.imageUrls.size() == 0 || (data.imageUrls[0] is string && data.imageUrls[0].size() <= 220000))))
        && data.status in ['New', 'Contacted', 'Inspection', 'Estimate Sent', 'Approved', 'In Repair', 'Ready for Delivery', 'Completed', 'Cancelled']
        && data.technicianNotes is string && data.technicianNotes.size() <= 2000
        && data.repairEstimate is string && data.repairEstimate.size() <= 120
        && data.followUpDate is string && data.followUpDate.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRepairTracking(data) {
      return data.keys().hasAll([
          'enquiryCode', 'macbookModel', 'serviceName', 'status',
          'repairEstimate', 'followUpDate', 'publicUpdateNote', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'enquiryCode', 'macbookModel', 'serviceName', 'status',
          'repairEstimate', 'followUpDate', 'publicUpdateNote', 'updatedAt'
        ])
        && data.enquiryCode is string && data.enquiryCode.size() >= 4 && data.enquiryCode.size() <= 32 && data.enquiryCode.matches('^RP-[A-Z0-9\\-]+$')
        && data.macbookModel is string && data.macbookModel.size() >= 2 && data.macbookModel.size() <= 140
        && data.serviceName is string && data.serviceName.size() >= 2 && data.serviceName.size() <= 160
        && data.status in ['New', 'Contacted', 'Inspection', 'Estimate Sent', 'Approved', 'In Repair', 'Ready for Delivery', 'Completed', 'Cancelled']
        && data.repairEstimate is string && data.repairEstimate.size() <= 120
        && data.followUpDate is string && data.followUpDate.size() <= 40
        && data.publicUpdateNote is string && data.publicUpdateNote.size() <= 500
        && data.updatedAt is timestamp;
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'phone', 'subject', 'message', 'isRead', 'createdAt'])
        && data.keys().hasOnly(['userId', 'name', 'phone', 'email', 'subject', 'message', 'isRead', 'adminReply', 'repliedAt', 'createdAt'])
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 25
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 160
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 2000
        && data.isRead is bool
        && (!('adminReply' in data) || (data.adminReply is string && data.adminReply.size() <= 2000))
        && (!('repliedAt' in data) || (data.repliedAt is string && data.repliedAt.size() <= 60))
        && data.createdAt is timestamp;
    }

    function isValidBlogCategory(data) {
      return data.keys().hasAll(['name', 'slug', 'createdAt'])
        && data.keys().hasOnly(['name', 'slug', 'description', 'createdAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 100 && data.slug.matches('^[a-z0-9\\-]+$')
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && data.createdAt is timestamp;
    }

    function isValidBlogPost(data) {
      return data.keys().hasAll([
          'title', 'slug', 'category', 'excerpt', 'content', 'featuredImage',
          'authorName', 'status', 'publishedAt', 'tags', 'faqs', 'isFeatured', 'views',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'slug', 'category', 'excerpt', 'content', 'featuredImage',
          'authorName', 'status', 'publishedAt', 'seoTitle', 'seoDescription',
          'tags', 'faqs', 'isFeatured', 'views', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 5 && data.title.size() <= 200
        && data.slug is string && data.slug.size() >= 3 && data.slug.size() <= 200 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
        && data.excerpt is string && data.excerpt.size() >= 10 && data.excerpt.size() <= 500
        && data.content is string && data.content.size() >= 20 && data.content.size() <= 30000
        && data.featuredImage is string && data.featuredImage.size() <= 300000
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 100
        && data.status in ['draft', 'published', 'scheduled']
        && data.publishedAt is string && data.publishedAt.size() <= 60
        && (!('seoTitle' in data) || (data.seoTitle is string && data.seoTitle.size() <= 160))
        && (!('seoDescription' in data) || (data.seoDescription is string && data.seoDescription.size() <= 320))
        && data.tags is list && data.tags.size() <= 10
        && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 60))
        && data.faqs is list && data.faqs.size() <= 10
        && data.isFeatured is bool
        && data.views is number && data.views >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['authorLabel', 'rating', 'quote', 'source', 'isVisible', 'createdAt'])
        && data.keys().hasOnly(['authorLabel', 'rating', 'quote', 'source', 'dateLabel', 'isVisible', 'createdAt'])
        && data.authorLabel is string && data.authorLabel.size() >= 2 && data.authorLabel.size() <= 100
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.quote is string && data.quote.size() >= 5 && data.quote.size() <= 800
        && data.source is string && data.source.size() >= 2 && data.source.size() <= 80
        && (!('dateLabel' in data) || (data.dateLabel is string && data.dateLabel.size() <= 60))
        && data.isVisible is bool
        && data.createdAt is timestamp;
    }

    function isValidGalleryImage(data) {
      return data.keys().hasAll(['title', 'imageUrl', 'category', 'sortOrder', 'createdAt'])
        && data.keys().hasOnly(['title', 'caption', 'imageUrl', 'category', 'sortOrder', 'createdAt'])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && (!('caption' in data) || (data.caption is string && data.caption.size() <= 300))
        && data.imageUrl is string && data.imageUrl.size() >= 2 && data.imageUrl.size() <= 300000
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 60
        && data.sortOrder is number
        && data.createdAt is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    // Admins
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isAdmin() || (isVerifiedUser() && request.auth.uid == adminUid));
      allow list: if isAdmin();
      allow create: if isValidId(adminUid)
        && isAdmin()
        && isValidAdminUser(incoming())
        && incoming().uid == adminUid
        && incoming().createdAt == request.time;
      allow update: if isValidId(adminUid)
        && isAdmin()
        && isValidAdminUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'role']);
      allow delete: if isValidId(adminUid) && isAdmin() && request.auth.uid != adminUid;
    }

    // Website Settings
    match /websiteSettings/{settingsId} {
      allow get: if isValidId(settingsId);
      allow list: if isAdmin();
      allow create: if isValidId(settingsId)
        && isAdmin()
        && isValidWebsiteSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(settingsId)
        && isAdmin()
        && isValidWebsiteSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'businessName', 'tagline', 'phone', 'whatsapp', 'email', 'websiteUrl',
          'address', 'businessHours', 'googleRating', 'googleReviewCount', 'googlePlaceId', 'googleReviewsUrl',
          'logoUrl', 'heroHeadline', 'heroSubheadline', 'heroImageUrl', 'heroSlides',
          'headerCtaText', 'headerCtaUrl', 'navLinks',
          'footerDescription', 'footerTagline', 'footerLegalText', 'footerQuickLinks', 'footerServiceLinks',
          'socialInstagram', 'socialFacebook',
          'seoTitle', 'seoDescription', 'seoKeywords', 'serviceAreasText',
          'homeFaqs', 'pageContent', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Services
    match /services/{serviceId} {
      allow get: if isValidId(serviceId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isAdmin();
      allow create: if isValidId(serviceId)
        && isAdmin()
        && isValidService(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(serviceId)
        && isAdmin()
        && isValidService(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'slug', 'category', 'shortDescription', 'repairInfo',
          'symptoms', 'imageUrl', 'priceDisplay', 'showPrice', 'isActive', 'sortOrder', 'updatedAt'
        ]);
      allow delete: if isValidId(serviceId) && isAdmin();
    }

    // MacBook, iPad & iPhone Models
    match /macbookModels/{modelId} {
      allow get: if isValidId(modelId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isAdmin();
      allow create: if isValidId(modelId)
        && isAdmin()
        && isValidMacBookModel(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(modelId)
        && isAdmin()
        && isValidMacBookModel(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'category', 'name', 'yearRange', 'processor', 'modelIdentifiers',
          'commonIssues', 'availabilityNote', 'isActive', 'updatedAt'
        ]);
      allow delete: if isValidId(modelId) && isAdmin();
    }

    // Repair Enquiries (Private PII - Admin or signed-in owner read; Admin update/delete; Public create with strict defaults)
    match /repairEnquiries/{enquiryId} {
      allow get: if isValidId(enquiryId) && (
        isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid) ||
        (isVerifiedUser() && existing().email != '' && existing().email == request.auth.token.email)
      );
      allow list: if isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid) ||
        (isVerifiedUser() && existing().email != '' && existing().email == request.auth.token.email);
      allow create: if isValidId(enquiryId)
        && isValidRepairEnquiry(incoming())
        && (!('userId' in incoming()) || incoming().userId == '' || (isSignedIn() && incoming().userId == request.auth.uid))
        && incoming().status == 'New'
        && incoming().technicianNotes == ''
        && incoming().repairEstimate == ''
        && incoming().followUpDate == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(enquiryId)
        && isAdmin()
        && isValidRepairEnquiry(incoming())
        && incoming().enquiryCode == existing().enquiryCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'technicianNotes', 'repairEstimate', 'followUpDate', 'updatedAt'])) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['customerName', 'mobile', 'whatsapp', 'email', 'macbookModel', 'macbookYear', 'processorType', 'serviceName', 'problemDescription', 'preferredContactMethod', 'preferredVisitDate', 'additionalNotes', 'status', 'technicianNotes', 'repairEstimate', 'followUpDate', 'updatedAt']))
        );
      allow delete: if isValidId(enquiryId) && isAdmin();
    }

    // Repair Tracking (Non-PII status projection keyed by SHA-256 hash of enquiryCode + normalized mobile)
    match /repairTracking/{trackingId} {
      allow get: if isValidId(trackingId);
      allow list: if isAdmin();
      allow create: if isValidId(trackingId)
        && isValidRepairTracking(incoming())
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (incoming().status == 'New' && incoming().repairEstimate == '' && incoming().followUpDate == '' && incoming().publicUpdateNote == '')
        );
      allow update: if isValidId(trackingId)
        && isAdmin()
        && isValidRepairTracking(incoming())
        && incoming().enquiryCode == existing().enquiryCode
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'macbookModel', 'serviceName', 'status', 'repairEstimate', 'followUpDate', 'publicUpdateNote', 'updatedAt'
        ]);
      allow delete: if isValidId(trackingId) && isAdmin();
    }

    // Contact Messages (Private PII - Admin or signed-in owner read; Admin reply/read/delete; Public create)
    match /contactMessages/{messageId} {
      allow get: if isValidId(messageId) && (
        isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid) ||
        (isVerifiedUser() && existing().email != '' && existing().email == request.auth.token.email)
      );
      allow list: if isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid) ||
        (isVerifiedUser() && existing().email != '' && existing().email == request.auth.token.email);
      allow create: if isValidId(messageId)
        && isValidContactMessage(incoming())
        && (!('userId' in incoming()) || incoming().userId == '' || (isSignedIn() && incoming().userId == request.auth.uid))
        && (!('adminReply' in incoming()) || incoming().adminReply == '')
        && (!('repliedAt' in incoming()) || incoming().repliedAt == '')
        && incoming().isRead == false
        && incoming().createdAt == request.time;
      allow update: if isValidId(messageId)
        && isAdmin()
        && isValidContactMessage(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'adminReply', 'repliedAt']);
      allow delete: if isValidId(messageId) && isAdmin();
    }

    // Blog Categories
    match /blogCategories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId)
        && isAdmin()
        && isValidBlogCategory(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(categoryId)
        && isAdmin()
        && isValidBlogCategory(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'description']);
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // Blog Posts
    match /blogPosts/{postId} {
      allow get: if isValidId(postId) && (existing().status == 'published' || isAdmin());
      allow list: if existing().status == 'published' || isAdmin();
      allow create: if isValidId(postId)
        && isAdmin()
        && isValidBlogPost(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(postId)
        && isAdmin()
        && isValidBlogPost(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'slug', 'category', 'excerpt', 'content', 'featuredImage',
          'authorName', 'status', 'publishedAt', 'seoTitle', 'seoDescription',
          'tags', 'faqs', 'isFeatured', 'views', 'updatedAt'
        ]);
      allow delete: if isValidId(postId) && isAdmin();
    }

    // Customer & Verified Google Reviews (Anyone can read visible reviews & submit a customer review; Admin moderates)
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (existing().isVisible == true || isAdmin());
      allow list: if existing().isVisible == true || isAdmin();
      allow create: if isValidId(reviewId)
        && isValidReview(incoming())
        && incoming().createdAt == request.time
        && (
          isAdmin() ||
          (incoming().isVisible == true && incoming().source == 'Website Customer Review')
        );
      allow update: if isValidId(reviewId)
        && isAdmin()
        && isValidReview(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'authorLabel', 'rating', 'quote', 'source', 'dateLabel', 'isVisible'
        ]);
      allow delete: if isValidId(reviewId) && isAdmin();
    }

    // Gallery Images
    match /galleryImages/{imageId} {
      allow get: if isValidId(imageId);
      allow list: if true;
      allow create: if isValidId(imageId)
        && isAdmin()
        && isValidGalleryImage(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(imageId)
        && isAdmin()
        && isValidGalleryImage(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'caption', 'imageUrl', 'category', 'sortOrder'
        ]);
      allow delete: if isValidId(imageId) && isAdmin();
    }
  }
}
